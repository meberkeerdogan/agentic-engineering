diff --git a/fulfillment/inventory.py b/fulfillment/inventory.py
--- a/fulfillment/inventory.py
+++ b/fulfillment/inventory.py
@@ -101 +101,17 @@
-        raise NotImplementedError("multi-target upgrade: ranked warehouse sources")
+        normalized_sku = normalize_sku(sku)
+        destination = normalize_identifier(destination_zone, "destination zone").casefold()
+        stocked = [
+            warehouse
+            for warehouse in self._warehouses.values()
+            if self.available(warehouse.warehouse_id, normalized_sku) > 0
+        ]
+        return tuple(
+            sorted(
+                stocked,
+                key=lambda warehouse: (
+                    warehouse.zone.casefold() != destination,
+                    warehouse.priority,
+                    warehouse.warehouse_id,
+                ),
+            )
+        )
diff --git a/fulfillment/orders.py b/fulfillment/orders.py
--- a/fulfillment/orders.py
+++ b/fulfillment/orders.py
@@ -100 +100,33 @@
-    raise NotImplementedError("multi-target upgrade: split order allocation")
+    checked = validate_order(order, catalog)
+    shortages = {
+        line.sku: line.quantity - inventory.total_available(line.sku)
+        for line in checked.lines
+        if inventory.total_available(line.sku) < line.quantity
+    }
+    if shortages:
+        detail = ", ".join(
+            f"{sku}={quantity}" for sku, quantity in sorted(shortages.items())
+        )
+        raise InsufficientStockError(f"order cannot be fully allocated: {detail}")
+
+    planned: list[Allocation] = []
+    for line in checked.lines:
+        remaining = line.quantity
+        for warehouse in inventory.ranked_sources(
+            line.sku, checked.destination_zone
+        ):
+            quantity = min(
+                remaining,
+                inventory.available(warehouse.warehouse_id, line.sku),
+            )
+            if quantity:
+                planned.append(Allocation(warehouse.warehouse_id, line.sku, quantity))
+                remaining -= quantity
+            if not remaining:
+                break
+
+    for allocation in planned:
+        inventory.reserve(
+            allocation.warehouse_id, allocation.sku, allocation.quantity
+        )
+    return tuple(planned)
