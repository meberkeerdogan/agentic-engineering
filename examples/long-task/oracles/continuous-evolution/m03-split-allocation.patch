diff --git a/fulfillment/orders.py b/fulfillment/orders.py
--- a/fulfillment/orders.py
+++ b/fulfillment/orders.py
@@ -100 +100,33 @@
-    raise NotImplementedError("multi-target upgrade: split order allocation")
+    checked = validate_order(order, catalog)
+    shortages = {
+        line.sku: line.quantity - inventory.total_available(line.sku)
+        for line in checked.lines
+        if inventory.total_available(line.sku) < line.quantity
+    }
+    if shortages:
+        detail = ", ".join(
+            f"{sku}={quantity}" for sku, quantity in sorted(shortages.items())
+        )
+        raise InsufficientStockError(f"order cannot be fully allocated: {detail}")
+
+    planned: list[Allocation] = []
