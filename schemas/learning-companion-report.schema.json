{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-engineering.dev/schemas/learning-companion-report.schema.json",
  "title": "Learning Companion Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "milestone_id", "source_fingerprint", "status", "learner_level", "agent_invoked", "lesson", "learning_path_proposal", "engineering_state_mutations", "verification_claims", "report_id", "fingerprint"],
  "properties": {
    "version": {"const": 1},
    "milestone_id": {"$ref": "#/$defs/id"},
    "source_fingerprint": {"$ref": "#/$defs/fingerprint"},
    "status": {"enum": ["proposed", "skipped"]},
    "learner_level": {"enum": ["beginner", "intermediate", "advanced"]},
    "agent_invoked": {"type": "boolean"},
    "lesson": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/lesson"}]},
    "learning_path_proposal": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/learningPath"}]},
    "engineering_state_mutations": {"type": "array", "maxItems": 0},
    "verification_claims": {"type": "array", "maxItems": 0},
    "report_id": {"$ref": "#/$defs/id"},
    "fingerprint": {"$ref": "#/$defs/fingerprint"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "proposed"}}}, "then": {"properties": {"agent_invoked": {"const": true}, "lesson": {"$ref": "#/$defs/lesson"}}}},
    {"if": {"properties": {"status": {"const": "skipped"}}}, "then": {"properties": {"agent_invoked": {"const": false}, "lesson": {"type": "null"}, "learning_path_proposal": {"type": "null"}}}}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "text": {"type": "string", "minLength": 1},
    "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "safeRef": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"},
    "texts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "refs": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/safeRef"}},
    "lesson": {"type": "object", "additionalProperties": false, "required": ["plain_english_summary", "concepts", "approach", "interpretation", "exercise", "review_questions", "focus_refs", "failed_experiment_lessons"], "properties": {"plain_english_summary": {"$ref": "#/$defs/text"}, "concepts": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["plain_english", "technical_term"], "properties": {"plain_english": {"$ref": "#/$defs/text"}, "technical_term": {"$ref": "#/$defs/text"}}}}, "approach": {"type": "object", "additionalProperties": false, "required": ["selected", "rationale", "alternatives"], "properties": {"selected": {"$ref": "#/$defs/text"}, "rationale": {"$ref": "#/$defs/text"}, "alternatives": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}}}, "interpretation": {"type": "object", "additionalProperties": false, "required": ["supported", "not_supported"], "properties": {"supported": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}, "not_supported": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}}}, "exercise": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]}, "review_questions": {"type": "array", "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}, "focus_refs": {"$ref": "#/$defs/refs"}, "failed_experiment_lessons": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["experiment_id", "lesson", "evidence_refs"], "properties": {"experiment_id": {"$ref": "#/$defs/id"}, "lesson": {"$ref": "#/$defs/text"}, "evidence_refs": {"$ref": "#/$defs/refs"}}}}}},
    "learningPath": {"type": "object", "additionalProperties": false, "required": ["completed_topics", "current_topics", "exercises", "suggested_next_topics"], "properties": {"completed_topics": {"$ref": "#/$defs/texts"}, "current_topics": {"$ref": "#/$defs/texts"}, "exercises": {"$ref": "#/$defs/texts"}, "suggested_next_topics": {"$ref": "#/$defs/texts"}}}
  }
}
