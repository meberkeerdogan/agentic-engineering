{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-engineering.dev/schemas/active-spec.schema.json",
  "title": "Active Specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "title", "objective", "status", "requirements", "constraints", "out_of_scope", "sources", "updated_at"],
  "properties": {
    "version": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "active", "superseded", "completed"] },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "priority", "status", "acceptance_criteria", "supersedes"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "statement": { "type": "string", "minLength": 1 },
          "priority": { "enum": ["must", "should", "could"] },
          "status": { "enum": ["active", "superseded"] },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "statement"],
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "statement": { "type": "string", "minLength": 1 }
              }
            }
          },
          "supersedes": {
            "type": "array",
            "items": { "$ref": "#/$defs/id" },
            "uniqueItems": true
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "out_of_scope": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "reference"],
        "properties": {
          "kind": { "enum": ["user", "issue", "file", "paper", "standard", "url"] },
          "reference": { "type": "string", "minLength": 1 },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }
  }
}

