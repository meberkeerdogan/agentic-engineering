{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-engineering.dev/schemas/phase-memory.schema.json",
  "title": "Phase-Aware Memory Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "memory_id", "capacity_per_phase", "entries", "query"],
  "properties": {
    "version": {"const": 1},
    "memory_id": {"$ref": "#/$defs/id"},
    "capacity_per_phase": {"type": "integer", "minimum": 1},
    "entries": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "phase", "kind", "task_id", "summary", "created_step", "evidence_refs", "supersedes"], "properties": {"id": {"$ref": "#/$defs/id"}, "phase": {"$ref": "#/$defs/phase"}, "kind": {"$ref": "#/$defs/kind"}, "task_id": {"$ref": "#/$defs/id"}, "summary": {"type": "string", "minLength": 1}, "created_step": {"type": "integer", "minimum": 1}, "evidence_refs": {"$ref": "#/$defs/refs"}, "supersedes": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}}}},
    "query": {"type": "object", "additionalProperties": false, "required": ["phase", "task_id", "kinds", "limit"], "properties": {"phase": {"$ref": "#/$defs/phase"}, "task_id": {"$ref": "#/$defs/id"}, "kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/kind"}}, "limit": {"type": "integer", "minimum": 1}}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "phase": {"enum": ["navigate", "reproduce", "patch", "validate", "complete"]},
    "kind": {"enum": ["decision", "failure", "artifact", "evidence"]},
    "refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
