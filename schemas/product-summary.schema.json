{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-engineering.dev/schemas/product-summary.schema.json",
  "title": "Verified Product Run Summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "workflow_id", "run_id", "status", "task_id", "spec_id", "claimed_complete", "verified_complete", "regressions", "scores", "measured_cost", "cost_unit", "time_seconds", "workspace_revision", "active_spec_ref", "evaluation_ref", "state_ref", "state_log_ref", "pilot_summary_ref", "evidence_refs"],
  "properties": {
    "version": { "const": 1 },
    "workflow_id": { "const": "verified-single-agent-v0.1" },
    "run_id": { "$ref": "#/$defs/id" },
    "status": { "enum": ["verified", "rejected", "blocked"] },
    "task_id": { "$ref": "#/$defs/id" },
    "spec_id": { "$ref": "#/$defs/id" },
    "claimed_complete": { "type": "boolean" },
    "verified_complete": { "type": "boolean" },
    "regressions": { "type": "integer", "minimum": 0 },
    "scores": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["targets_passed", "targets_total", "target_completion", "strict_target_completion"],
          "properties": {
            "targets_passed": { "type": "integer", "minimum": 0 },
            "targets_total": { "type": "integer", "minimum": 1 },
            "target_completion": { "type": "number", "minimum": 0, "maximum": 1 },
            "strict_target_completion": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      ]
    },
    "measured_cost": { "type": "number", "minimum": 0 },
    "cost_unit": { "type": "string", "minLength": 1 },
    "time_seconds": { "type": "number", "minimum": 0 },
    "workspace_revision": { "$ref": "#/$defs/id" },
    "active_spec_ref": { "$ref": "#/$defs/path" },
    "evaluation_ref": { "$ref": "#/$defs/path" },
    "state_ref": { "$ref": "#/$defs/path" },
    "state_log_ref": { "$ref": "#/$defs/path" },
    "pilot_summary_ref": { "$ref": "#/$defs/path" },
    "evidence_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+" }
  }
}
