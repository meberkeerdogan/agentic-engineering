{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-engineering.dev/schemas/task-pack.schema.json",
  "title": "Representative Experiment Task Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "pack_id", "title", "experiment_ref", "requirements", "task_bindings"],
  "properties": {
    "version": { "const": 1 },
    "pack_id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1 },
    "experiment_ref": { "$ref": "#/$defs/relativePath" },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_distinct_repositories", "minimum_seeds", "required_categories"],
      "properties": {
        "minimum_distinct_repositories": { "type": "integer", "minimum": 2 },
        "minimum_seeds": { "type": "integer", "minimum": 2 },
        "required_categories": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["bounded-bug-fix", "multi-file-feature", "multi-step-evolution"] }
        }
      }
    },
    "task_bindings": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "evidence_contract_ref", "expected_baseline_outcome", "expected_failing_evaluator_ids"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "category": { "enum": ["bounded-bug-fix", "multi-file-feature", "multi-step-evolution"] },
          "evidence_contract_ref": { "$ref": "#/$defs/relativePath" },
          "expected_baseline_outcome": { "const": "fail" },
          "expected_failing_evaluator_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+"
    }
  }
}
