{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-engineering.dev/schemas/verified-state.schema.json",
  "title": "Verified Run State",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "run_id", "spec_id", "status", "work_items", "decisions", "evidence", "best_known_revision", "audit_sequence", "updated_at"],
  "properties": {
    "version": { "const": 1 },
    "run_id": { "$ref": "#/$defs/id" },
    "spec_id": { "$ref": "#/$defs/id" },
    "status": { "enum": ["planned", "running", "blocked", "verified", "rejected", "failed"] },
    "work_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "depends_on", "attempt_count", "artifact_refs", "evidence_refs", "last_error"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "status": { "enum": ["pending", "ready", "running", "awaiting_audit", "verified", "rejected", "blocked"] },
          "depends_on": {
            "type": "array",
            "items": { "$ref": "#/$defs/id" },
            "uniqueItems": true
          },
          "attempt_count": { "type": "integer", "minimum": 0 },
          "artifact_refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "evidence_refs": {
            "type": "array",
            "items": { "$ref": "#/$defs/id" },
            "uniqueItems": true
          },
          "last_error": { "type": ["string", "null"] }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "summary", "basis", "created_at"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "summary": { "type": "string", "minLength": 1 },
          "basis": { "type": "string", "minLength": 1 },
          "created_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "evaluator_id", "outcome", "artifact_refs", "recorded_at"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "evaluator_id": { "$ref": "#/$defs/id" },
          "outcome": { "enum": ["pass", "fail", "error"] },
          "artifact_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "recorded_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "best_known_revision": { "type": ["string", "null"] },
    "audit_sequence": { "type": "integer", "minimum": 0 },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }
  }
}

