{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-engineering.dev/schemas/paper-reproduction.schema.json",
  "title": "Claim-Level Paper Reproduction",
  "type": "object",
  "required": ["version", "reproduction_id", "paper", "lineage", "environment", "experiment_root", "experiments", "rubric", "deviations"],
  "properties": {
    "version": {"const": 1},
    "reproduction_id": {"$ref": "#/$defs/id"},
    "paper": {"type": "object", "required": ["id", "title", "pdf_ref", "sha256", "claim_id", "claim", "source_pages"]},
    "lineage": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "kind", "ref", "relationship", "sha256"], "properties": {"kind": {"enum": ["paper", "reference_code", "derived_fixture", "environment_lock"]}, "sha256": {"$ref": "#/$defs/fingerprint"}}}},
    "environment": {"type": "object", "required": ["runtime", "lock_ref", "network", "model_calls"], "properties": {"network": {"const": "disabled"}, "model_calls": {"const": "disabled"}}},
    "experiment_root": {"type": "string", "minLength": 1},
    "experiments": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "command", "timeout_seconds", "expected_observation", "evidence_refs"]}},
    "rubric": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "experiment_id", "path", "expected", "evidence_refs"]}},
    "deviations": {"type": "array", "items": {"type": "object", "required": ["id", "description", "impact", "evidence_refs"]}}
  },
  "additionalProperties": false,
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}, "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
