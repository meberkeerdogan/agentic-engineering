{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-engineering.dev/schemas/live-experiment.schema.json",
  "title": "Live Codex Experiment Launcher",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "batch_ref", "rates_ref", "environment_ref", "model", "sandbox", "approval_mode", "timeout_seconds", "task_bindings"],
  "properties": {
    "version": { "const": 1 },
    "batch_ref": { "$ref": "#/$defs/relativePath" },
    "rates_ref": { "$ref": "#/$defs/relativePath" },
    "environment_ref": { "$ref": "#/$defs/relativePath" },
    "model": { "type": "string", "minLength": 1 },
    "sandbox": { "enum": ["read-only", "workspace-write"] },
    "approval_mode": { "enum": ["none", "auto-review"] },
    "timeout_seconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 3600 },
    "task_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "evidence_contract_ref"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "evidence_contract_ref": { "$ref": "#/$defs/relativePath" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+"
    }
  }
}
