{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-engineering.dev/schemas/milestone-chain-report.schema.json",
  "title": "Persistent Milestone Chain Validation Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "chain_id", "status", "manifest_fingerprint", "base_fingerprint", "milestone_count", "model_calls_performed", "milestones", "omission_probe", "report_id", "fingerprint"],
  "properties": {
    "version": { "const": 1 },
    "chain_id": { "$ref": "#/$defs/id" },
    "status": { "const": "ready" },
    "manifest_fingerprint": { "$ref": "#/$defs/hash" },
    "base_fingerprint": { "$ref": "#/$defs/hash" },
    "milestone_count": { "type": "integer", "minimum": 4, "maximum": 6 },
    "model_calls_performed": { "const": false },
    "milestones": {
      "type": "array",
      "minItems": 4,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "depends_on", "initial_target_completion", "isolated_target_completion", "continuous_target_completion", "continuous_isolated_gap", "regressions", "state_fingerprint", "evaluation_fingerprint"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "depends_on": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
          "initial_target_completion": { "type": "number", "minimum": 0, "maximum": 1 },
          "isolated_target_completion": { "type": "number", "minimum": 0, "maximum": 1 },
          "continuous_target_completion": { "type": "number", "minimum": 0, "maximum": 1 },
          "continuous_isolated_gap": { "type": "number", "minimum": -1, "maximum": 1 },
          "regressions": { "type": "integer", "minimum": 0 },
          "state_fingerprint": { "$ref": "#/$defs/hash" },
          "evaluation_fingerprint": { "$ref": "#/$defs/hash" }
        }
      }
    },
    "omission_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["omitted_milestone_id", "final_outcome", "regressions", "strict_target_completion", "evaluation_fingerprint"],
      "properties": {
        "omitted_milestone_id": { "$ref": "#/$defs/id" },
        "final_outcome": { "enum": ["fail", "error"] },
        "regressions": { "type": "integer", "minimum": 1 },
        "strict_target_completion": { "const": 0 },
        "evaluation_fingerprint": { "$ref": "#/$defs/hash" }
      }
    },
    "report_id": { "$ref": "#/$defs/id" },
    "fingerprint": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
