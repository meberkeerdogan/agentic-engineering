{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-engineering.dev/schemas/live-pilot.schema.json",
  "title": "Live Pilot Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "pilot_id", "template_ref", "run_root_ref", "arm", "task", "evidence_contract_ref", "rates_ref", "environment_ref", "model", "sandbox", "approval_mode", "timeout_seconds", "seed"],
  "properties": {
    "version": { "const": 1 },
    "pilot_id": { "$ref": "#/$defs/id" },
    "template_ref": { "$ref": "#/$defs/relativePath" },
    "run_root_ref": { "$ref": "#/$defs/relativePath" },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "workflow", "config_ref"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "workflow": { "type": "string", "minLength": 1 },
        "config_ref": { "$ref": "#/$defs/relativePath" }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository", "spec_ref"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "repository": { "type": "string", "minLength": 1 },
        "spec_ref": { "$ref": "#/$defs/relativePath" }
      }
    },
    "evidence_contract_ref": { "$ref": "#/$defs/relativePath" },
    "spec_history_ref": { "$ref": "#/$defs/relativePath" },
    "rates_ref": { "$ref": "#/$defs/relativePath" },
    "environment_ref": { "$ref": "#/$defs/relativePath" },
    "model": { "type": "string", "minLength": 1 },
    "sandbox": { "enum": ["read-only", "workspace-write"] },
    "approval_mode": { "enum": ["none", "auto-review"] },
    "timeout_seconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 3600 },
    "seed": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+"
    }
  }
}
