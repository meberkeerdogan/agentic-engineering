{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-engineering.dev/schemas/trajectory.schema.json",
  "title": "Coding Agent Trajectory",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "trajectory_id", "task_id", "events"],
  "properties": {
    "version": { "const": 1 },
    "trajectory_id": { "$ref": "#/$defs/id" },
    "task_id": { "$ref": "#/$defs/id" },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "phase", "action", "target", "state_fingerprint", "evidence_refs"],
        "properties": {
          "step": { "type": "integer", "minimum": 1 },
          "phase": { "enum": ["navigate", "reproduce", "patch", "validate", "complete"] },
          "action": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "state_fingerprint": { "type": "string", "minLength": 1 },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }
  }
}
