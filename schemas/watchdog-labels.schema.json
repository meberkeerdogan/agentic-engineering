{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-engineering.dev/schemas/watchdog-labels.schema.json",
  "title": "Watchdog Signal Labels",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "label_set_id", "report_id", "report_fingerprint", "labels", "missed_signals"],
  "properties": {
    "version": { "const": 1 },
    "label_set_id": { "$ref": "#/$defs/id" },
    "report_id": { "$ref": "#/$defs/id" },
    "report_fingerprint": { "$ref": "#/$defs/fingerprint" },
    "labels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signal_id", "verdict", "rationale", "evidence_refs"],
        "properties": {
          "signal_id": { "$ref": "#/$defs/id" },
          "verdict": { "enum": ["true_positive", "false_positive"] },
          "rationale": { "type": "string", "minLength": 1 },
          "evidence_refs": { "$ref": "#/$defs/evidence_refs" }
        }
      }
    },
    "missed_signals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "start_step", "end_step", "rationale", "evidence_refs"],
        "properties": {
          "type": { "$ref": "#/$defs/signal_type" },
          "start_step": { "type": "integer", "minimum": 1 },
          "end_step": { "type": "integer", "minimum": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "evidence_refs": { "$ref": "#/$defs/evidence_refs" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "signal_type": { "enum": ["repeated_action", "stagnation", "action_oscillation", "premature_patching", "skipped_validation"] },
    "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
