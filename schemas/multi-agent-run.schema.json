{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-engineering.dev/schemas/multi-agent-run.schema.json",
  "title": "Isolated Multi-Agent Run",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "run_id", "max_parallelism", "commit_timestamp", "tasks", "validation"],
  "properties": {
    "version": {"const": 1},
    "run_id": {"$ref": "#/$defs/id"},
    "max_parallelism": {"type": "integer", "minimum": 1},
    "commit_timestamp": {"type": "string", "minLength": 1},
    "tasks": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "depends_on", "command", "timeout_seconds", "allowed_paths", "evidence_refs"], "properties": {"id": {"$ref": "#/$defs/id"}, "depends_on": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "command": {"$ref": "#/$defs/command"}, "timeout_seconds": {"type": "integer", "minimum": 1}, "allowed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "evidence_refs": {"$ref": "#/$defs/refs"}}}},
    "validation": {"type": "object", "additionalProperties": false, "required": ["command", "timeout_seconds"], "properties": {"command": {"$ref": "#/$defs/command"}, "timeout_seconds": {"type": "integer", "minimum": 1}}}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}, "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
}
