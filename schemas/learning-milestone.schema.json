{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-engineering.dev/schemas/learning-milestone.schema.json",
  "title": "Learning Companion Milestone",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "milestone_id", "title", "outcome", "learner", "verified_facts", "decisions", "failed_experiments", "focus_refs", "learning_path_ref", "companion_policy"],
  "properties": {
    "version": {"const": 1},
    "milestone_id": {"$ref": "#/$defs/id"},
    "title": {"$ref": "#/$defs/text"},
    "outcome": {"enum": ["verified", "failed", "inconclusive"]},
    "learner": {"type": "object", "additionalProperties": false, "required": ["level", "goals"], "properties": {"level": {"enum": ["beginner", "intermediate", "advanced"]}, "goals": {"$ref": "#/$defs/shortTexts"}}},
    "verified_facts": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "statement", "evidence_refs"], "properties": {"id": {"$ref": "#/$defs/id"}, "statement": {"$ref": "#/$defs/text"}, "evidence_refs": {"$ref": "#/$defs/refs"}}}},
    "decisions": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "selected", "rationale", "alternatives", "evidence_refs"], "properties": {"id": {"$ref": "#/$defs/id"}, "selected": {"$ref": "#/$defs/text"}, "rationale": {"$ref": "#/$defs/text"}, "alternatives": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}, "evidence_refs": {"$ref": "#/$defs/refs"}}}},
    "failed_experiments": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "outcome", "lesson", "evidence_refs"], "properties": {"id": {"$ref": "#/$defs/id"}, "outcome": {"enum": ["failed", "inconclusive"]}, "lesson": {"$ref": "#/$defs/text"}, "evidence_refs": {"$ref": "#/$defs/refs"}}}},
    "focus_refs": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/safeRef"}},
    "learning_path_ref": {"$ref": "#/$defs/safeRef"},
    "companion_policy": {"type": "object", "additionalProperties": false, "required": ["enabled", "proposal_only", "cadence", "update_learning_path", "include_exercise", "include_review_questions", "maximum_focus_refs"], "properties": {"enabled": {"type": "boolean"}, "proposal_only": {"const": true}, "cadence": {"const": "meaningful_milestones"}, "update_learning_path": {"type": "boolean"}, "include_exercise": {"type": "boolean"}, "include_review_questions": {"type": "boolean"}, "maximum_focus_refs": {"type": "integer", "minimum": 1, "maximum": 4}}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "text": {"type": "string", "minLength": 1},
    "shortTexts": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "safeRef": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"},
    "refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/safeRef"}}
  }
}
