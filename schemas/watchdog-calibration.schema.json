{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-engineering.dev/schemas/watchdog-calibration.schema.json",
  "title": "Watchdog Calibration Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "calibration_id", "policy", "cases"],
  "properties": {
    "version": { "const": 1 },
    "calibration_id": { "$ref": "#/$defs/id" },
    "policy": { "$ref": "#/$defs/policy" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["report", "labels"],
        "properties": {
          "report": { "type": "string", "minLength": 1 },
          "labels": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_labels", "minimum_precision", "minimum_recall"],
      "properties": {
        "minimum_labels": { "type": "integer", "minimum": 1 },
        "minimum_precision": { "type": "number", "minimum": 0, "maximum": 1 },
        "minimum_recall": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
