{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-engineering.dev/schemas/dependency-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "plan_id", "tasks", "runtime_states"],
  "properties": {
    "version": {"const": 1},
    "plan_id": {"$ref": "#/$defs/id"},
    "tasks": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "depends_on", "priority", "evidence_refs"], "properties": {"id": {"$ref": "#/$defs/id"}, "depends_on": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "priority": {"type": "integer"}, "evidence_refs": {"$ref": "#/$defs/refs"}}}},
    "runtime_states": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "state", "evidence_refs"], "properties": {"id": {"$ref": "#/$defs/id"}, "state": {"enum": ["pending", "completed", "failed"]}, "evidence_refs": {"$ref": "#/$defs/refs"}}}}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}, "refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
}
