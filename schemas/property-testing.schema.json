{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-engineering.dev/schemas/property-testing.schema.json",
  "title": "Reviewed Property-Test Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "suite_id", "proposals", "reviews", "results"],
  "properties": {
    "version": {"const": 1},
    "suite_id": {"$ref": "#/$defs/id"},
    "proposals": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "proposer_role", "requirement_id", "statement", "oracle", "evidence_refs"], "properties": {"id": {"$ref": "#/$defs/id"}, "proposer_role": {"const": "agent"}, "requirement_id": {"$ref": "#/$defs/id"}, "statement": {"type": "string", "minLength": 1}, "oracle": {"type": "string", "minLength": 1}, "evidence_refs": {"$ref": "#/$defs/refs"}}}},
    "reviews": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["proposal_id", "reviewer_role", "verdict", "rationale", "evidence_refs"], "properties": {"proposal_id": {"$ref": "#/$defs/id"}, "reviewer_role": {"const": "independent_auditor"}, "verdict": {"enum": ["accepted", "rejected"]}, "rationale": {"type": "string", "minLength": 1}, "evidence_refs": {"$ref": "#/$defs/refs"}}}},
    "results": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["proposal_id", "outcome", "read_only", "evidence_refs"], "properties": {"proposal_id": {"$ref": "#/$defs/id"}, "outcome": {"enum": ["pass", "counterexample", "invalid"]}, "read_only": {"const": true}, "evidence_refs": {"$ref": "#/$defs/refs"}}}}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}, "refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
}
