{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-engineering.dev/schemas/experiment-observations.schema.json",
  "title": "Experiment Replay Observations",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "observations"],
  "properties": {
    "version": { "const": 1 },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "arm_id",
          "task_id",
          "seed",
          "claimed_complete",
          "verified_complete",
          "regressions",
          "cost",
          "time_seconds",
          "human_interventions",
          "evidence_refs"
        ],
        "properties": {
          "arm_id": { "$ref": "#/$defs/id" },
          "task_id": { "$ref": "#/$defs/id" },
          "seed": { "type": "integer", "minimum": 0 },
          "claimed_complete": { "type": "boolean" },
          "verified_complete": { "type": "boolean" },
          "regressions": { "type": "integer", "minimum": 0 },
          "cost": { "type": "number", "minimum": 0 },
          "time_seconds": { "type": "number", "minimum": 0 },
          "human_interventions": { "type": "integer", "minimum": 0 },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }
  }
}
