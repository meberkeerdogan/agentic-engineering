{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-engineering.dev/schemas/multi-agent-report.schema.json",
  "title": "Isolated Multi-Agent Integration Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "run_id", "source_fingerprint", "base_revision", "parallel_waves", "task_results", "integration_revision", "validation", "conflicts", "human_interventions", "worktree_refs", "report_id", "fingerprint"],
  "properties": {
    "version": {"const": 1},
    "run_id": {"$ref": "#/$defs/id"},
    "source_fingerprint": {"$ref": "#/$defs/fingerprint"},
    "base_revision": {"$ref": "#/$defs/revision"},
    "parallel_waves": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}},
    "task_results": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["task_id", "status", "commit", "changed_paths", "stdout_sha256", "stderr_sha256"], "properties": {"task_id": {"$ref": "#/$defs/id"}, "status": {"const": "completed"}, "commit": {"$ref": "#/$defs/revision"}, "changed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "stdout_sha256": {"$ref": "#/$defs/fingerprint"}, "stderr_sha256": {"$ref": "#/$defs/fingerprint"}}}},
    "integration_revision": {"$ref": "#/$defs/revision"},
    "validation": {"type": "object", "additionalProperties": false, "required": ["outcome", "stdout_sha256", "stderr_sha256"], "properties": {"outcome": {"const": "pass"}, "stdout_sha256": {"$ref": "#/$defs/fingerprint"}, "stderr_sha256": {"$ref": "#/$defs/fingerprint"}}},
    "conflicts": {"type": "array", "maxItems": 0},
    "human_interventions": {"const": 0},
    "worktree_refs": {"type": "object", "minProperties": 2, "additionalProperties": {"type": "string", "minLength": 1}},
    "report_id": {"$ref": "#/$defs/id"},
    "fingerprint": {"$ref": "#/$defs/fingerprint"}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}, "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "revision": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"}}
}
