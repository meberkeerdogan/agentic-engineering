{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-engineering.dev/schemas/codex-preflight-report.schema.json",
  "title": "Codex Experiment Preflight Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "isolation", "codex_version", "authentication", "model", "model_available", "rate_effective_date", "rate_age_days", "structured_output_schema", "enabled_plugin_count", "enabled_mcp_count", "prompt_item_count", "prompt_json_bytes", "maximum_prompt_json_bytes", "baseline_prompt_json_bytes", "prompt_json_byte_reduction", "prompt_json_byte_reduction_percent", "model_call_performed"],
  "properties": {
    "version": { "const": 1 },
    "status": { "const": "passed" },
    "isolation": { "const": "temporary-codex-home" },
    "codex_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "authentication": { "const": "chatgpt" },
    "model": { "type": "string", "minLength": 1 },
    "model_available": { "const": true },
    "rate_effective_date": { "type": "string", "format": "date" },
    "rate_age_days": { "type": "integer", "minimum": 0 },
    "structured_output_schema": { "const": "compatible" },
    "enabled_plugin_count": { "const": 0 },
    "enabled_mcp_count": { "const": 0 },
    "prompt_item_count": { "type": "integer", "minimum": 1 },
    "prompt_json_bytes": { "type": "integer", "minimum": 1 },
    "maximum_prompt_json_bytes": { "type": "integer", "minimum": 1 },
    "baseline_prompt_json_bytes": { "type": ["integer", "null"], "minimum": 1 },
    "prompt_json_byte_reduction": { "type": ["integer", "null"] },
    "prompt_json_byte_reduction_percent": { "type": ["number", "null"] },
    "model_call_performed": { "const": false }
  }
}
